<UserControl x:Class="ScreenInk.App.ScreenshotPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="630" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="320" Spacing="12">
            <TextBlock x:Name="PanelTitle" Text="Little snapshot" FontSize="20" FontWeight="SemiBold"/>
            <Border x:Name="PreviewBorder" CornerRadius="12" Background="#22232D" Padding="4"><Image x:Name="Preview" MaxHeight="180" Stretch="Uniform" AutomationProperties.Name="Captured screenshot preview"/></Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Save" Click="OnSaveClicked" CornerRadius="10"/>
                <Button x:Name="CopyButton" Content="Copy" Click="OnCopyClicked" CornerRadius="10"/>
                <Button x:Name="ShareButton" Content="Share QR" Click="OnShareClicked" CornerRadius="10"/>
                <Button Content="New" Click="OnNewClicked" CornerRadius="10" AutomationProperties.Name="Take a new screenshot" ToolTipService.ToolTip="Take another screenshot"/>
            </StackPanel>
            <StackPanel x:Name="ShareArea" Visibility="Collapsed" Spacing="10">
                <ComboBox x:Name="NetworkChoice" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnNetworkChanged" AutomationProperties.Name="Wi-Fi or Ethernet network for sharing"/>
                <Border Background="White" CornerRadius="12" Padding="8" HorizontalAlignment="Center"><Image x:Name="QrImage" Width="220" Height="220" Stretch="Uniform" AutomationProperties.Name="Scan to open the screenshot"/></Border>
                <TextBlock Text="Scan on the same Wi-Fi. Link works while sharing is on." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ShareStatus" TextWrapping="Wrap" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyLinkButton" Content="Copy link" Click="OnCopyLinkClicked" CornerRadius="10"/>
                    <Button x:Name="StopButton" Content="Stop sharing" Click="OnStopClicked" CornerRadius="10"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
