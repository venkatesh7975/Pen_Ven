<Window x:Class="ScreenInk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScreenInk">
    <Border x:Name="ToolbarRoot" Loaded="OnContentLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14">
        <Border.Resources>
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10"/><Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Border.Resources>
        <Grid>
        <Button x:Name="OpenToolbarButton" Visibility="Collapsed" Width="48" Height="48" Padding="12" CornerRadius="24" Background="#7775D6" Click="OnOpenToolbarClicked" AutomationProperties.Name="Open ScreenInk" ToolTipService.ToolTip="Open ScreenInk"><SymbolIcon Symbol="Edit"/></Button>
        <ScrollViewer x:Name="ToolbarContent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="8" Spacing="4">
                <Grid Height="20" x:Name="DragGrip" Background="Transparent" PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCanceled="OnGripReleased" PointerCaptureLost="OnGripCaptureLost" ToolTipService.ToolTip="Drag the toolbar" AutomationProperties.Name="Move ScreenInk toolbar">
                    <TextBlock Text="⠿" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="CursorButton" Style="{StaticResource ToolButtonStyle}" Click="OnClickThroughClicked" AutomationProperties.Name="Cursor mode" ToolTipService.ToolTip="Cursor · use other apps while keeping ink visible (Ctrl+Alt+F9)">
                    <PathIcon Data="M3,1 L3,18 L7,14 L11,22 L14,20 L10,12 L17,12 Z"/>
                </Button>
                <Button x:Name="PenButton" Style="{StaticResource ToolButtonStyle}" Click="OnPenClicked" AutomationProperties.Name="Pen" ToolTipService.ToolTip="Pen · click, then draw outside the toolbar"><SymbolIcon Symbol="Edit"/></Button>
                <Button x:Name="EraserButton" Style="{StaticResource ToolButtonStyle}" Click="OnEraserClicked" AutomationProperties.Name="Stroke eraser" ToolTipService.ToolTip="Eraser · removes the whole annotation you touch"><PathIcon Data="M2,13 L11,2 L22,11 L13,22 L8,22 Z M8,7 L19,16"/></Button>
                <Button x:Name="ShapesButton" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Shapes" ToolTipService.ToolTip="Shapes · line, arrow, rectangle or ellipse">
                    <PathIcon Data="M1,2 L20,2 L20,20 L1,20 Z M3,4 L3,18 L18,18 L18,4 Z"/>
                    <Button.Flyout><MenuFlyout Placement="Left" ShouldConstrainToRootBounds="False">
                        <MenuFlyoutItem Text="Line" Tag="Line" Click="OnShapeClicked"/>
                        <MenuFlyoutItem Text="Arrow" Tag="Arrow" Click="OnShapeClicked"/>
                        <MenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="OnShapeClicked"/>
                        <MenuFlyoutItem Text="Ellipse" Tag="Ellipse" Click="OnShapeClicked"/>
                    </MenuFlyout></Button.Flyout>
                </Button>
                <Button x:Name="LaserButton" Style="{StaticResource ToolButtonStyle}" Click="OnLaserClicked" AutomationProperties.Name="Laser pointer" ToolTipService.ToolTip="Laser · press and drag to point; lift to hide">
                    <PathIcon Data="M12,0 L12,5 L10,5 L10,0 Z M12,17 L12,22 L10,22 L10,17 Z M0,10 L5,10 L5,12 L0,12 Z M17,10 L22,10 L22,12 L17,12 Z M11,6 C18,6 18,16 11,16 C4,16 4,6 11,6 Z"/>
                </Button>
                <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Button Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Ink color" ToolTipService.ToolTip="{x:Bind ViewModel.ColorLabel, Mode=OneWay}">
                    <Ellipse x:Name="ColorSwatch" Width="22" Height="22" Fill="#FF5050" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"/>
                    <Button.Flyout><Flyout Placement="Left" ShouldConstrainToRootBounds="False"><StackPanel Width="300" Spacing="12">
                        <TextBlock Text="Ink color" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Background="#FF5050" Tag="FF5050" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Red" AutomationProperties.Name="Red ink"/>
                            <Button Grid.Column="1" Background="#FFB938" Tag="FFB938" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Yellow" AutomationProperties.Name="Yellow ink"/>
                            <Button Grid.Column="2" Background="#43DB9B" Tag="43DB9B" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Green" AutomationProperties.Name="Green ink"/>
                            <Button Grid.Column="3" Background="#43B7FF" Tag="43B7FF" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Blue" AutomationProperties.Name="Blue ink"/>
                            <Button Grid.Column="4" Background="#BC8AFF" Tag="BC8AFF" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Purple" AutomationProperties.Name="Purple ink"/>
                            <Button Grid.Column="5" Background="White" Tag="FFFFFF" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="White" AutomationProperties.Name="White ink"/>
                            <Button Grid.Column="6" Background="Black" Tag="000000" Click="OnQuickColorClicked" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Black" AutomationProperties.Name="Black ink"/>
                        </Grid>
                        <ColorPicker x:Name="InkColorPicker" Color="#FF5050" ColorChanged="OnColorChanged" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsColorSliderVisible="False" IsColorChannelTextInputVisible="False"/>
                        <TextBlock Text="{x:Bind ViewModel.ColorLabel, Mode=OneWay}"/>
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Tool size" ToolTipService.ToolTip="Pen / shape width and eraser diameter">
                    <PathIcon Data="M3,4 L19,4 L19,6 L3,6 Z M3,10 L19,10 L19,14 L3,14 Z M3,18 L19,18 L19,24 L3,24 Z"/>
                    <Button.Flyout><Flyout Placement="Left" ShouldConstrainToRootBounds="False"><StackPanel Width="240" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.PenSizeLabel, Mode=OneWay}"/>
                        <Slider Minimum="1" Maximum="32" Value="4" StepFrequency="1" ValueChanged="OnPenSizeChanged" AutomationProperties.Name="Pen and shape width in pixels"/>
                        <TextBlock Text="{x:Bind ViewModel.EraserSizeLabel, Mode=OneWay}"/>
                        <Slider Minimum="4" Maximum="128" Value="24" StepFrequency="1" ValueChanged="OnEraserSizeChanged" AutomationProperties.Name="Stroke eraser diameter in physical pixels"/>
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnUndoClicked" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.UndoTooltip, Mode=OneWay}" AutomationProperties.Name="Undo annotation">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoShortcutInvoked"/></Button.KeyboardAccelerators><SymbolIcon Symbol="Undo"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnRedoClicked" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.RedoTooltip, Mode=OneWay}" AutomationProperties.Name="Redo annotation">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoShortcutInvoked"/></Button.KeyboardAccelerators><SymbolIcon Symbol="Redo"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnClearAllClicked" IsEnabled="{x:Bind ViewModel.HasInk, Mode=OneWay}" AutomationProperties.Name="Clear all annotations" ToolTipService.ToolTip="Clear all · Undo restores annotations"><SymbolIcon Symbol="Delete"/></Button>
                <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Button x:Name="ScreenshotButton" Style="{StaticResource ToolButtonStyle}" Click="OnScreenshotClicked" AutomationProperties.Name="Take screenshot" ToolTipService.ToolTip="Screenshot · save, copy or share with QR">
                    <SymbolIcon Symbol="Camera"/>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnMediaClicked" AutomationProperties.Name="Media and definitions" ToolTipService.ToolTip="Images, videos &amp; definition cards"><SymbolIcon Symbol="Pictures"/></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="OnHideOverlayClicked" AutomationProperties.Name="Hide ScreenInk" ToolTipService.ToolTip="Hide toolbar and ink · click the little pen to open"><SymbolIcon Symbol="Back"/></Button>
                <Button Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="More options" ToolTipService.ToolTip="Help, display options and annotation list">
                    <SymbolIcon Symbol="More"/>
                    <Button.Flyout><Flyout Placement="Left" ShouldConstrainToRootBounds="False"><ScrollViewer MaxHeight="600"><StackPanel Width="300" Spacing="10">
                        <TextBlock Text="ScreenInk" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Choose Pen or a shape, then draw outside this toolbar. Cursor lets you use other apps. Laser appears while you press and drag." TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ToolStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.OverlayModeLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.OverlayDetails, Mode=OneWay}" TextWrapping="Wrap"/>
                        <CheckBox Content="Show monitor boundary" Checked="OnBoundaryChanged" Unchecked="OnBoundaryChanged"/>
                        <CheckBox Content="Light toolbar" Checked="OnThemeChanged" Unchecked="OnThemeChanged"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.StrokeChoices}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedStroke, Mode=TwoWay}" PlaceholderText="No annotations yet" HorizontalAlignment="Stretch" AutomationProperties.Name="Select an annotation to delete"/>
                        <Button Content="Delete selected" Click="OnDeleteSelectedClicked" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.HistoryShortcuts, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.PointerStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.PenDetails, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ErrorStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel></ScrollViewer></Flyout></Button.Flyout>
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Height="32" Click="OnCloseClicked" AutomationProperties.Name="Exit ScreenInk" ToolTipService.ToolTip="Exit ScreenInk · ends this temporary session"><SymbolIcon Symbol="Cancel"/></Button>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Border>
</Window>
